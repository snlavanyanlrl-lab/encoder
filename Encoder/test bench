`timescale 1ns/1ps

module encoder_tb;

reg  [7:0] D;
wire [2:0] Y;

// Instantiate Encoder
encoder uut(
    .D(D),
    .Y(Y)
);

initial begin

    $display("Input D         Output Y");
    $monitor("%b     %b", D, Y);

    D = 8'b00000001; #10;
    D = 8'b00000010; #10;
    D = 8'b00000100; #10;
    D = 8'b00001000; #10;
    D = 8'b00010000; #10;
    D = 8'b00100000; #10;
    D = 8'b01000000; #10;
    D = 8'b10000000; #10;

    $finish;

end

endmodule